  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login - Dono de Restaurante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token retornado com sucesso\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
                  "    pm.collectionVariables.set(\"bearer_token\", jsonData.accessToken);",
                  "});",
                  "pm.test(\"UserType é DONO_DE_RESTAURANTE\", function () {",
                  "    pm.expect(jsonData.user.userType.name).to.eql('DONO_DE_RESTAURANTE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dono@restaurante.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
