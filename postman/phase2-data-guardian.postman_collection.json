  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login - Dono de Restaurante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\nvar jsonData = pm.response.json();\npm.test(\"Token retornado com sucesso\", function () {\n    pm.expect(jsonData.accessToken).to.be.a('string');\n    pm.expect(jsonData.tokenType).to.eql('Bearer');\n    if (pm.environment) {\n        pm.environment.set(\"token\", jsonData.accessToken);\n        pm.environment.set(\"bearer_token\", jsonData.accessToken);\n    }\n    pm.collectionVariables.set(\"token\", jsonData.accessToken);\n    pm.collectionVariables.set(\"bearer_token\", jsonData.accessToken);\n    pm.globals.set(\"token\", jsonData.accessToken);\n    pm.globals.set(\"bearer_token\", jsonData.accessToken);\n});\npm.test(\"UserType é DONO_DE_RESTAURANTE\", function () {\n    pm.expect(jsonData.user.userType.name).to.eql('DONO_DE_RESTAURANTE');\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dono@restaurante.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login - Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token retornado com sucesso\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
                  "    if (pm.environment) {",
                  "        pm.environment.set(\"token\", jsonData.accessToken);",
                  "        pm.environment.set(\"bearer_token\", jsonData.accessToken);",
                  "    }",
                  "    pm.collectionVariables.set(\"token\", jsonData.accessToken);",
                  "    pm.collectionVariables.set(\"bearer_token\", jsonData.accessToken);",
                  "    pm.globals.set(\"token\", jsonData.accessToken);",
                  "    pm.globals.set(\"bearer_token\", jsonData.accessToken);",
                  "});",
                  "pm.test(\"UserType é CLIENTE\", function () {",
                  "    pm.expect(jsonData.user.userType.name).to.eql('CLIENTE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@email.com\",\n  \"password\": \"cliente123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login - Credenciais Inválidas (Edge Case 401)",
