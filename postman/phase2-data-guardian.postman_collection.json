{
  "info": {
    "_postman_id": "c85d7f21-789a-4c92-bf39-858349258901",
    "name": "Phase 2 - Data Guardian API",
    "description": "Collection completa para testes de Autenticação JWT, Autorização baseada em UserType (DONO_DE_RESTAURANTE e CLIENTE), extração de dados do token e gestão de usuários.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "client_bearer_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login - Dono de Restaurante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token retornado com sucesso\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
                  "    pm.collectionVariables.set(\"bearer_token\", jsonData.accessToken);",
                  "});",
                  "pm.test(\"UserType é DONO_DE_RESTAURANTE\", function () {",
                  "    pm.expect(jsonData.user.userType.name).to.eql('DONO_DE_RESTAURANTE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dono@restaurante.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Cliente",
          "event": [
            {
